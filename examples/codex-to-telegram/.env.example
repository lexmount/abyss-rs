# Copy to .env (ignored by Git), then use node --env-file=.env dist/main.js.
# Fill in both environment variables before forwarding events.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ABYSS_BROKER_STARTUP_INFO=/absolute/path/to/startup-info.json
# Optional, independent of the proxy used by Codex:
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
# ABYSS_TELEGRAM_STATE_DIR=/absolute/path/to/private/state
# ABYSS_TELEGRAM_SESSION_ID=only-this-session
