{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lexmount.net/abyss/broker-plugin/v1/agent-event.schema.json",
  "title": "Abyss broker plugin protocol version 1 AgentEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "occurred_at",
    "device",
    "agent",
    "session_id",
    "llm",
    "side",
    "token_usage"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "device": {
      "$ref": "#/$defs/deviceContext"
    },
    "agent": {
      "$ref": "#/$defs/agentContext"
    },
    "session_id": {
      "type": "string"
    },
    "response_id": {
      "type": "string"
    },
    "previous_response_id": {
      "type": "string"
    },
    "purpose": {
      "enum": [
        "session_title",
        "compaction",
        "prewarm"
      ]
    },
    "llm": {
      "$ref": "#/$defs/llmContext"
    },
    "side": {
      "enum": [
        "request",
        "response"
      ]
    },
    "text": {
      "type": "string"
    },
    "token_usage": {
      "$ref": "#/$defs/tokenUsage"
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/toolCall"
      }
    },
    "tool_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/toolResult"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/imageAttachment"
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "enum": [
          "token_usage",
          "conversation_text",
          "tool_content",
          "images"
        ]
      }
    },
    "conversation": {
      "$ref": "#/$defs/conversation"
    },
    "headers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/httpHeader"
      }
    }
  },
  "$defs": {
    "deviceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_name",
        "platform"
      ],
      "properties": {
        "host_name": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "os_version": {
          "type": "string"
        }
      }
    },
    "agentContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "llmContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    },
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "reasoning_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "name",
        "input",
        "input_sha256"
      ],
      "properties": {
        "call_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "input_sha256": {
          "type": "string"
        }
      }
    },
    "toolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "output",
        "output_sha256"
      ],
      "properties": {
        "call_id": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "output_sha256": {
          "type": "string"
        }
      }
    },
    "imageAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "media_type",
        "byte_size",
        "sha256"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/gif"
          ]
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        },
        "content_base64": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "completeness"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conversationEntry"
          }
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unsupported"
          ]
        }
      }
    },
    "conversationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "text"
      ],
      "properties": {
        "role": {
          "enum": [
            "system",
            "developer",
            "user",
            "assistant",
            "reasoning",
            "tool_call",
            "tool_result",
            "unknown"
          ]
        },
        "text": {
          "type": "string"
        },
        "call_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        }
      }
    },
    "httpHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "value_base64": {
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "value_base64"
          ]
        }
      ]
    }
  }
}
